---
import "../../styles/story.css";

import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
	const stories = await getCollection("stories");

	return stories.map((story) => ({
		params: {
			id: story.id,
		},
		props: {
			story,
		},
	}));
}

const { story } = Astro.props;
const { Content } = await render(story);
const isBackgroundStory = story.data.section === "background";
const backHref = isBackgroundStory ? `/about#${story.id}` : "/stories";
const backLabel = isBackgroundStory ? "Об авторе" : "Все истории";
---

<BaseLayout title={story.data.title} description={story.data.description}>
	<Header />

	<main class="story-page">
		<section class="story-header">
			<div class="story-header__inner">
				<a
					href={backHref}
					class="text-caps arrow-link arrow-link--back"
					data-history-back={isBackgroundStory ? "" : undefined}
				>
					<span class="icon-arrow icon-arrow--back" aria-hidden="true"></span>
					{backLabel}
				</a>

				<div class="story-header__content">
					<div class="story-header__main">
						<h2 class="story-header__title">{story.data.title}</h2>

						<p class="story-header__description">{story.data.description}</p>
					</div>

					<dl class="story-header__meta">
						<div>
							<dt class="text-caps">Направление</dt>
							<dd>{story.data.category}</dd>
						</div>
						{story.data.company && (
							<div>
								<dt class="text-caps">Компания</dt>
								<dd>{story.data.company}</dd>
							</div>
						)}
						{story.data.role && (
							<div>
								<dt class="text-caps">Роль</dt>
								<dd>{story.data.role}</dd>
							</div>
						)}
						{story.data.date && (
							<div>
								<dt class="text-caps">Год</dt>
								<dd>{story.data.date}</dd>
							</div>
						)}
					</dl>
				</div>
			</div>
		</section>

		<div class="story-header__divider"></div>

		<article class="story-content text-small">
			<div class="story-content__layout">
				<Content />
			</div>
		</article>
	</main>

	<Footer />
</BaseLayout>

<script>
	const historyBackLink = document.querySelector<HTMLAnchorElement>(
		"[data-history-back]",
	);

	historyBackLink?.addEventListener("click", (event) => {
		if (!document.referrer) return;

		const referrer = new URL(document.referrer);
		const cameFromAbout =
			referrer.origin === window.location.origin &&
			referrer.pathname.replace(/\/$/, "") === "/about";

		if (!cameFromAbout) return;

		event.preventDefault();
		window.history.back();
	});
</script>
