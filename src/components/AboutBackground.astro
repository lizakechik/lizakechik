---
import "../styles/aboutBackground.css";

type ParagraphSegment = string | { bold: string };
type BackgroundParagraph = string | ParagraphSegment[];

const backgroundItems: {
	number: string;
	title: string;
	paragraphs: BackgroundParagraph[];
}[] = [
	{
		number: "➤",
		title: "Знания закладывают основу",
		paragraphs: [
			"Для меня знания — это не набор фактов, а опора, которая позволяет глубже понимать предмет и уверенно двигаться дальше. Мне важно не просто узнать новое, а понять, как это работает.",
			[
				"Моя академическая база — ",
				{ bold: "бакалавриат по прикладной математике и информатике" },
				" и ",
				{ bold: "магистратура по фундаментальной информатике и информационным технологиям" },
				" в РУДН.",
			],
			[
				"Профессиональное образование продолжаю дополнять специализированными программами. Среди наиболее значимых — ",
				{ bold: "Google UX Design Professional Certificate" },
				", ",
				{ bold: "«Продакт-менеджмент» школы продактов HeadHunter" },
				" и ",
				{ bold: "UI Skills в FAANG+ Career" },
				".",
			],
		],
	},
	{
		number: "➤",
		title: "Опыт формирует взгляд",
		paragraphs: [
			"За профессиональную карьеру я успела поработать с разными продуктами и в разных ролях.",
			[
				"Я начинала с аналитики и работы с данными, позже занималась собственными проектами, проектировала пользовательский опыт, а со временем перешла к управлению продуктом. В ",
				{ bold: "SOKOLOV" },
				" я училась исследовать поведение пользователей и превращать наблюдения в продуктовые решения. В ",
				{ bold: "BORK" },
				" прошла путь от продуктового дизайнера до продакт-менеджера, постепенно расширяя зону ответственности от отдельных сценариев до продукта целиком.",
			],
			"Этот опыт научил меня смотреть на задачу с разных сторон. Я могу говорить с дизайнером о пользовательском сценарии, с разработчиком — о логике и ограничениях, с бизнесом — о целях и приоритетах, не теряя при этом общей картины.",
		],
	},
	{
		number: "➤",
		title: "Интересы расширяют перспективу",
		paragraphs: [
			"Продуктовая работа требует широкого взгляда, поэтому мне важно сохранять любопытство за пределами своей профессии. Я люблю пробовать новое, погружаться в незнакомые темы и расширять профессиональный контекст.",
			"Это помогает замечать связи между разными областями и переносить подходы из одной сферы в другую. Для меня широкий кругозор — не про то, чтобы знать все, а про возможность смотреть на знакомые задачи под новым углом и находить неожиданные решения.",
		],
	},
	{
		number: "➤",
		title: "Мышление определяет подход",
		paragraphs: [
			"Мне важно сначала понять, что именно мы пытаемся решить, а уже потом искать способ это сделать. В сложных задачах легко увлечься деталями или начать улучшать что-то, не договорившись о самой проблеме. Поэтому я стараюсь отступить на шаг назад, разобраться в контексте и найти главный вопрос.",
			"Такой подход помогает соединять разные точки зрения и не принимать первое очевидное решение за единственно возможное. Мне интересно не просто найти ответ, а понять, почему он имеет смысл в конкретной ситуации.",
		],
	},
];
---

<section class="about-background">
	<div class="about-background__container">
		<p class="about-background__label text-caps">Мой бэкграунд</p>

		<div class="about-background__list">
			{
				backgroundItems.map((item) => (
					<article class="about-background__item">
						<div class="item-number">{item.number}</div>

						<div class="about-background__content">
							<h4 class="about-background__title">
								{item.title}
							</h4>

							<div class="about-background__text">
								{item.paragraphs.map((paragraph) => (
									<p class="text-small">
										{typeof paragraph === "string"
											? paragraph
											: paragraph.map((segment) =>
													typeof segment === "string" ? segment : <strong>{segment.bold}</strong>,
												)}
									</p>
								))}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
