---
import "../styles/aboutBackground.css";

const backgroundItems: {
	icon: string;
	title: string;
	paragraphs: string[];
}[] = [
	{
		icon: "/images/about-background-1.svg",
		title: "Знания закладывают основу",
		paragraphs: [
			"Для меня знания — это не набор фактов, а опора, которая позволяет глубже понимать предмет и уверенно двигаться дальше. Мне важно не просто узнать новое, а понять, как это работает.",
		],
	},
	{
		icon: "/images/about-background-2.svg",
		title: "Опыт формирует взгляд",
		paragraphs: [
			"За свою карьеру я успела поработать с разными продуктами и в разных ролях. Начинала с аналитики данных, позже занималась собственными проектами, проектировала пользовательский опыт, а со временем перешла к управлению продуктом.",
		],
	},
	{
		icon: "/images/about-background-3.svg",
		title: "Интересы расширяют перспективу",
		paragraphs: [
			"Продуктовая работа требует широкого взгляда, поэтому мне важно сохранять любопытство за пределами своей профессии. Я люблю пробовать новое, погружаться в незнакомые темы и расширять профессиональный контекст.",
		],
	},
	{
		icon: "/images/about-background-4.svg",
		title: "Мышление определяет подход",
		paragraphs: [
			"Мне важно сначала понять, что именно мы пытаемся решить. В сложных задачах легко увлечься деталями, не договорившись о самой проблеме. Поэтому я стараюсь отступить на шаг назад, разобраться в контексте и найти главный вопрос.",
		],
	},
];
---

<section class="about-background">
	<div class="about-background__container">
		<p class="about-background__label text-caps">Мой бэкграунд</p>

		<div class="about-background__list">
			{
				backgroundItems.map((item) => (
					<article class="about-background__item">
						<div class="about-background__icon" aria-hidden="true">
							<img src={item.icon} alt="" />
						</div>

						<div class="about-background__content">
							<h4 class="about-background__title">
								{item.title}
							</h4>

							<div class="about-background__text">
								{item.paragraphs.map((paragraph) => (
									<p class="text-small">{paragraph}</p>
								))}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
