---
import "../styles/aboutBackground.css";

const backgroundItems = [
	{
		number: "I",
		title: "Знания закладывают основу",
		paragraphs: [
			"Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
		],
		details: [
			{
				number: "2024",
				title: "Курс по UI Skills в FAANG+ Career",
				text: "",
			},
			{
				number: "2023",
				title: "Продакт-менеджмент в школе продактов HeadHunter",
				text: "",
			},
			{
				number: "2022",
				title: "Google UX Design Professional Certificate",
				text: "",
			},
			{
				number: "2015",
				title: "Магистр фундаментальной информатики и информационных технологий, РУДН",
				text: "",
			},
			{
				number: "2012",
				title: "Бакалавр прикладной математики и информатики, РУДН",
				text: "",
			},
		],
	},
	{
		number: "II",
		title: "Опыт формирует взгляд",
		paragraphs: [
			"За профессиональную карьеру я успела поработать с разными продуктами и в разных ролях.",
		],
 		details: [
			{
				number: "2022 нв",
				title: "BORK",
				text: "Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
			},
			{
				number: "2019 2022",
				title: "SOKOLOV",
				text: "Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
			},
		], 
	},
	{
		number: "III",
		title: "Интересы расширяют перспективу",
		paragraphs: [
			"Продуктовая работа требует широкого взгляда, поэтому мне важно сохранять любопытство за пределами своей профессии. Я люблю пробовать новое, погружаться в незнакомые темы и расширять профессиональный контекст.",
			"Это помогает замечать связи между разными областями и переносить подходы из одной сферы в другую. Для меня широкий кругозор — не про то, чтобы знать всё, а про возможность смотреть на знакомые задачи под новым углом и находить неожиданные решения.",
		],
	},
	{
		number: "IV",
		title: "Мышление определяет подход",
		paragraphs: [
			"Мне важно сначала понять, что именно мы пытаемся решить, а уже потом искать способ это сделать. В сложных задачах легко увлечься деталями или начать улучшать что-то, не договорившись о самой проблеме. Поэтому я стараюсь отступить на шаг назад, разобраться в контексте и найти главный вопрос.",
			"Такой подход помогает соединять разные точки зрения и не принимать первое очевидное решение за единственно возможное. Мне интересно не просто найти ответ, а понять, почему он имеет смысл в конкретной ситуации.",
		],
	},
];
---

<section class="about-background">
	<div class="about-background__container">

		<p class="about-background__label text-caps">
			Мой бэкграунд
		</p>

		<div class="about-background__list">
			{
				backgroundItems.map((item) => (
					<article class="about-background__item">
						<div class="item-number">{item.number}</div>

						<div class="about-background__content">

							<h4 class="about-background__title">
								{item.title}
							</h4>

							<div class="about-background__text">
								{
									item.paragraphs.map((paragraph) => (
										<p class="text-small">{paragraph}</p>
									))
								}
							</div>

							{
								item.details && (
									<div class="about-background__details">
										{
											item.details.map((detail) => (
												<div class="about-background__detail">

													<div class="about-background__detail-year">
														{detail.number}
													</div>

													<div class="about-background__detail-content">
														<h5>{detail.title}</h5>

														{
															detail.text && (
																<p class="text-small">
																	{detail.text}
																</p>
															)
														}
													</div>

												</div>
											))
										}
									</div>
								)
							}

						</div>

					</article>
				))
			}
		</div>

	</div>
</section>
