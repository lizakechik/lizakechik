---
import "../styles/aboutBackground.css";

const backgroundItems = [
	{
		title: "Знания закладывают основу",
		layout: "new",
		paragraphs: [
			"Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
		],
		details: [
			{
				number: "2024",
				title: "Курс по UI Skills в FAANG+ Career",
				text: "",
			},
			{
				number: "2023",
				title: "Продакт-менеджмент в школе продактов HeadHunter",
				text: "",
			},
			{
				number: "2022",
				title: "Google UX Design Professional Certificate",
				text: "",
			},
			{
				number: "2015",
				title: "Магистр фундаментальной информатики и информационных технологий, РУДН",
				text: "",
			},
			{
				number: "2012",
				title: "Бакалавр прикладной математики и информатики, РУДН",
				text: "",
			},
		],
	},
	{
		title: "Опыт формирует взгляд",
		layout: "new",
		paragraphs: [
			"За профессиональную карьеру я успела поработать с разными продуктами и в разных ролях.",
		],
		details: [
			{
				number: "2022 — нв",
				title: "BORK",
				text: "Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
			},
			{
				number: "2019 — 22",
				title: "SOKOLOV",
				text: "Постоянно изучаю новые инструменты, подходы и технологии, которые помогают мне развиваться в профессиональной сфере.",
			},
		],
	},
	{
		title: "Интересы расширяют перспективу",
		layout: "new",
		paragraphs: [
			"Первый абзац текста.",
			"Второй абзац текста.",
		],
	},
	{
		title: "Мышление определяет подход",
		layout: "new",
		paragraphs: [
			"Первый абзац текста.",
		],
	},
];
---

<section class="about-background">
	<div class="about-background__container">

		<p class="about-background__label text-caps">
			Мой бэкграунд
		</p>

		<div class="about-background__list">
			{
				backgroundItems.map((item) => (
					<article class="about-background__item about-background__item--new">

						<div class="about-background__content">

							<h3 class="about-background__title">
								{item.title}
							</h3>

							<div class="about-background__text">
								{
									item.paragraphs.map((paragraph) => (
										<p class="text-small">{paragraph}</p>
									))
								}
							</div>

							{
								item.details && (
									<div class="about-background__details">
										{
											item.details.map((detail) => (
												<div class="about-background__detail">

													<div class="about-background__detail-number">
														{detail.number}
													</div>

													<div class="about-background__detail-content">
														<h5>{detail.title}</h5>

														{
															detail.text && (
																<p class="text-small">
																	{detail.text}
																</p>
															)
														}
													</div>

												</div>
											))
										}
									</div>
								)
							}

						</div>

					</article>
				))
			}
		</div>

	</div>
</section>