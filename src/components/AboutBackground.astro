---
import "../styles/aboutBackground.css";

const backgroundItems: {
	label: string;
	title: string;
	paragraphs: string[];
	href: string;
}[] = [
	{
		label: "Знания",
		title: "Закладывают основу",
		paragraphs: [
			"Для меня знания — это не набор фактов, а опора, которая позволяет глубже понимать предмет и уверенно двигаться дальше. Мне важно не просто узнать новое, а понять, как это работает.",
		],
		href: "/stories/knowledge-as-foundation",
	},
	{
		label: "Опыт",
		title: "Формирует взгляд",
		paragraphs: [
			"За свою карьеру я успела поработать в разных ролях. Начинала с аналитики данных, позже занималась собственными проектами, проектировала пользовательский опыт, а со временем перешла к управлению продуктом.",
		],
		href: "/stories/experience-shapes-perspective",
	},
	{
		label: "Интересы",
		title: "Расширяют перспективу",
		paragraphs: [
			"Продуктовая работа требует широкого взгляда, поэтому мне важно сохранять любопытство за пределами своей профессии. Я люблю пробовать новое, погружаться в незнакомые темы и расширять профессиональный контекст.",
		],
		href: "/stories/interests-expand-perspective",
	},
	{
		label: "Мышление",
		title: "Определяет подход",
		paragraphs: [
			"Мне важно сначала понять, что именно мы пытаемся решить. В сложных задачах легко увлечься деталями, не договорившись о самой проблеме. Поэтому я стараюсь отступить на шаг назад, разобраться в контексте и найти главный вопрос.",
		],
		href: "/stories/thinking-defines-approach",
	},
];
---

<section class="about-background">
	<div class="about-background__container">
		<div class="about-background__heading">
			<p class="about-background__label text-caps section-kicker">Мой бэкграунд</p>
		</div>

		<div class="about-background__list">
			{
				backgroundItems.map((item) => (
					<article
						id={item.href.replace("/stories/", "")}
						class="about-background__item"
					>
						<a href={item.href} class="about-background__link">
							<div class="about-background__content">
								<h4 class="about-background__title">
									{item.label}
								</h4>

								<p class="about-background__principle text-caps">{item.title}</p>

								<div class="about-background__text">
									{item.paragraphs.map((paragraph) => (
										<p class="text-small">{paragraph}</p>
									))}
								</div>
							</div>

							<span class="about-background__arrow icon-arrow icon-arrow--external" aria-hidden="true"></span>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
