---
import "../styles/featuredStories.css";

const stories = [
	{
		num: "01",
		title: "Почему оформление заказа сложнее, чем кажется",
		description:
			"История о том, как разобраться в сложном пользовательском сценарии и найти решения, которые работают для всех сторон.",
		tags: "CASES • 2023",
		href: "/stories/checkout",
	},
	{
		num: "02",
		title: "Как мы перестали строить продукты в вакууме",
		description:
			"О том, как выстроить процесс принятия решений на основе исследований, а не предположений.",
		tags: "STRATEGY • RESEARCH",
		href: "/stories/product-strategy",
	},
	{
		num: "03",
		title: "Как привычка превратилась в первый собственный продукт",
		description:
			"История Nutmix Everyday — от наблюдения за собственной привычкой до продукта, который можно было взять в руки.",
		tags: "STRATEGY • OWN PRODUCT",
		href: "/stories/nutmix-everyday",
	},
    {
		num: "04",
        title: "Что меняется, когда начинаешь слушать пользователя",
        description: 
            "История о том, как исследования помогают увидеть проблему за пределами очевидных решений.",
		tags: "RESEARCH",
		href: "/stories/user-research",
	},
];
---

<section class="stories-section">
	<div class="stories-container">
		<div class="stories-heading">
			<p class="stories-label text-caps section-kicker">Избранные истории</p>
			<h2>Продуктовые<br />истории</h2>
			<a href="/stories" class="text-caps arrow-link">
				Все истории
				<span class="icon-arrow" aria-hidden="true"></span>
			</a>
		</div>

		<div class="story-list">
			{
				stories.map((story) => (
					<article class="story-row">
						<a href={story.href} class="story-row__link">
							<span class="story-row__number text-caps">{story.num}</span>

							<div class="story-row__body">
								<h4 class="story-row__title">{story.title}</h4>

                                <p class="story-row__desc text-small">
                                    {story.description}
                                </p>

                                <p class="story-row__tags text-caps">{story.tags}</p>
							</div>
							<span class="story-row__arrow icon-arrow icon-arrow--external" aria-hidden="true"></span>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
